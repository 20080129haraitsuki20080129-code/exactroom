# ============================================================================
# ExactRoom 環境変数の例
#   cp .env.example .env して値を埋める。.env は絶対にコミットしない。
# ============================================================================

# ---- 基本 ----
# 画面に出すアプリ名
APP_NAME=ExactRoom
# 公開 URL (案内文などに使う。空でもよい)
BASE_URL=

# ---- 必須 ----
# 署名鍵。次のコマンドで生成する:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# development | production | test
ENVIRONMENT=development

# ---- データベース ----
# ローカル / 単一サーバ (SQLite)
DATABASE_URL=sqlite:///./data/exactroom.db
# 無料の PostgreSQL (Neon / Supabase など) を使う場合の例:
# DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/exactroom?sslmode=require

# ---- フロントを別ホストに置く場合の CORS 許可オリジン (カンマ区切り) ----
# 同一オリジンで配信するなら空のままでよい
CORS_ORIGINS=
# 例: CORS_ORIGINS=https://yourname.github.io,https://exactroom.pages.dev

# ---- 判定エンジン ----
# process = 別プロセス + ハードタイムアウト (推奨) / inline = 同一プロセス
JUDGE_ISOLATION=process
JUDGE_WORKERS=2
JUDGE_TIMEOUT_SEC=8

# ---- 入力制限 ----
MAX_ANSWER_CHARS=500
MAX_STATEMENT_CHARS=2000
MAX_PROBLEMS_PER_ROOM=200
MAX_TITLE_CHARS=120
MAX_NAME_CHARS=24

# ---- 部屋 ----
ROOM_CODE_LENGTH=6
# 出題者が自分で部屋コードを決める場合の最短の長さ
ROOM_CODE_MIN_LENGTH=3
MIN_SECRET_CHARS=8
ALLOW_ROOM_CREATION=true
# 公開サーバで誰でも部屋を作れると困る場合、合言葉を設定する
ROOM_CREATION_TOKEN=

# ---- セッション有効期間 (時間) ----
SESSION_TTL_HOURS=12
HOST_SESSION_TTL_HOURS=12

# ---- レート制限 (メモリ内。単一プロセス前提) ----
RATE_LIMIT_ENABLED=true
RATE_JOIN_PER_MINUTE=20
RATE_HOST_LOGIN_PER_MINUTE=10
RATE_SUBMIT_PER_MINUTE=30
RATE_CREATE_ROOM_PER_HOUR=10
RATE_GENERAL_PER_MINUTE=240
SUBMISSION_COOLDOWN_SEC=3

# ---- リバースプロキシ配下 (Render / Fly / Cloudflare など) では true ----
TRUST_PROXY_HEADERS=false

# ---- CSP で許可する CDN (MathLive / KaTeX) ----
CDN_HOSTS=https://cdn.jsdelivr.net https://unpkg.com

# ---- 静的ファイルを同一オリジンで配信するか ----
SERVE_STATIC=true
